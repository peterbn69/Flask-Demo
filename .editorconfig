# Top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,rs,java}]
indent_size = 4

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

# Markdown uses trailing double-space for hard line breaks
[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
